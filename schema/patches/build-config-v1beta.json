{
  "$id": "https://ocidoc.org/schema/build-config-v1beta.json",
  "$defs": {
    "BuildConfig": {
      "properties": {
        "components": {
          "examples": [
            {
              "documentation": {
                "paths": [
                  "/README*.md",
                  "/docs/**"
                ],
                "entrypoint": "/README.md",
                "locales": {
                  "en": {
                    "default": true,
                    "entrypoint": "/README.md",
                    "paths": [
                      "/README.md",
                      "/docs/en/**"
                    ]
                  },
                  "ru": {
                    "entrypoint": "/README.ru.md",
                    "paths": [
                      "/README.ru.md",
                      "/docs/ru/**"
                    ]
                  }
                }
              },
              "changelog": {
                "paths": [
                  "/CHANGELOG.md"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
