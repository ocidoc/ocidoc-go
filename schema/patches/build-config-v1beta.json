{
  "$defs": {
    "BuildConfig": {
      "properties": {
        "annotations": {
          "examples": [
            {
              "org.opencontainers.image.title": "Project documentation",
              "org.opencontainers.image.version": "1.2.3"
            }
          ]
        },
        "components": {
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:documentation|license|changelog|release-notes|security|contributing|code-of-conduct|support|x-[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
          },
          "examples": [
            {
              "documentation": {
                "paths": [
                  "/README*.md",
                  "/docs/**"
                ],
                "entrypoint": "/README.md",
                "locales": {
                  "en": {
                    "default": true,
                    "entrypoint": "/README.md",
                    "paths": [
                      "/README.md",
                      "/docs/en/**"
                    ]
                  },
                  "ru": {
                    "entrypoint": "/README.ru.md",
                    "paths": [
                      "/README.ru.md",
                      "/docs/ru/**"
                    ]
                  }
                }
              },
              "changelog": {
                "paths": [
                  "/CHANGELOG.md"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
