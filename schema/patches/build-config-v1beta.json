{
  "$id": "https://ocidoc.org/schema/build-config-v1beta.json",
  "$defs": {
    "BuildConfig": {
      "properties": {
        "components": {
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:documentation|license|changelog|release-notes|security|contributing|code-of-conduct|support|x-[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
          },
          "additionalProperties": {
            "minItems": 1
          }
        },
        "entrypoints": {
          "propertyNames": {
            "pattern": "^(?:documentation|license|changelog|release-notes|security|contributing|code-of-conduct|support|x-[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
          }
        }
      }
    }
  }
}
