{
  "$defs": {
    "ArtifactConfig": {
      "properties": {
        "$schema": {
          "const": "https://ocidoc.org/schema/artifact-config-v1beta.json"
        },
        "components": {
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:documentation|license|changelog|release-notes|security|contributing|code-of-conduct|support|x-[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
          },
          "examples": [
            {
              "documentation": {
                "entrypoint": "README.md",
                "locales": {
                  "en": {
                    "default": true,
                    "entrypoint": "README.md",
                    "files": [
                      "README.md",
                      "docs/en/guide.md"
                    ]
                  },
                  "ru": {
                    "entrypoint": "README.ru.md",
                    "files": [
                      "README.ru.md",
                      "docs/ru/guide.md"
                    ]
                  }
                }
              },
              "changelog": {
                "entrypoint": "CHANGELOG.md"
              }
            }
          ]
        }
      }
    }
  }
}
