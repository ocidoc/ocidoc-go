{
  "$id": "https://ocidoc.org/schema/artifact-config-v1beta.json",
  "$defs": {
    "ArtifactConfig": {
      "properties": {
        "$schema": {
          "const": "https://ocidoc.org/schema/artifact-config-v1beta.json"
        },
        "components": {
          "examples": [
            {
              "documentation": {
                "entrypoint": "README.md",
                "locales": {
                  "en": {
                    "default": true,
                    "entrypoint": "README.md",
                    "files": [
                      "README.md",
                      "docs/en/guide.md"
                    ]
                  },
                  "ru": {
                    "entrypoint": "README.ru.md",
                    "files": [
                      "README.ru.md",
                      "docs/ru/guide.md"
                    ]
                  }
                }
              },
              "changelog": {
                "entrypoint": "CHANGELOG.md"
              }
            }
          ]
        }
      }
    }
  }
}
