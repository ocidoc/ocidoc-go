{
  "schemaVersion": "v1beta",
  "settings": {
    "strict": false,
    "compression": {
      "type": "gzip",
      "level": 6
    }
  },
  "document": {
    "id": "default",
    "variant": "default"
  },
  "ignore": [
    "/.git/**",
    "/.hg/**",
    "/.svn/**",
    "/.idea/**",
    "/.vscode/**",
    "/**/.DS_Store",
    "/**/Thumbs.db"
  ],
  "annotations": {
    "org.opencontainers.image.title": "Project documentation",
    "org.opencontainers.image.version": "1.2.3"
  },
  "components": {
    "documentation": {
      "entrypoint": "/README.md",
      "paths": ["/README", "/README.*", "/docs/**"],
      "locales": {
        "en": {
          "default": true,
          "entrypoint": "/README.md",
          "paths": ["/README.md", "/docs/en/**"]
        },
        "ru": {
          "entrypoint": "/README.ru.md",
          "paths": ["/README.ru.md", "/docs/ru/**"]
        }
      }
    },
    "security": {
      "paths": ["/SECURITY.md"]
    }
  }
}
